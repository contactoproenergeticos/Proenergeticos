# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase (sitio + script npm run sync:precios)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Secreto para /api/cron/sync-precios (y recomendado para otros crons). Vercel envía Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=""

# Tabla configuraciones_globales: fila clave "tipo_cambio_usd_mxn" con valor_numerico (tipo de cambio actual)

# Vercel: desactiva la barra flotante de comentarios/preview (círculo con logo) en Preview/Producción.
# En el dashboard: Project → Settings → General → Vercel Toolbar → Off. O deja 0 aquí en variables del proyecto.
# VERCEL_PREVIEW_FEEDBACK_ENABLED=0

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

