# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase (sitio + script npm run sync:precios)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Obligatorio para que /admin-precios GUARDE en Supabase (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=""

# Panel oculto /admin-precios (PIN de 4 dígitos; por defecto 4321 si no se define)
ADMIN_PRECIOS_PIN="4321"

# Secreto para /api/cron/sync-precios (y recomendado para otros crons). Vercel envía Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=""

# Tabla configuraciones_globales:
# - tipo_cambio_usd_mxn → valor_numerico (tipo de cambio)
# - precios_modo_captura → valor_texto "automatico" | "manual" (cron CRE vs edición en /admin-precios)

# Vercel: desactiva la barra flotante de comentarios/preview (círculo con logo) en Preview/Producción.
# En el dashboard: Project → Settings → General → Vercel Toolbar → Off. O deja 0 aquí en variables del proyecto.
# VERCEL_PREVIEW_FEEDBACK_ENABLED=0

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

